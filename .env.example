# Endpoint that returns the current Spotify track in JSON form.
# Expected fields: isPlaying, title, artist, albumArtUrl, songUrl
VITE_SPOTIFY_NOW_PLAYING_URL=https://your-domain.com/api/spotify-now-playing

# Optional: how often (in ms) the widget polls for updates. Minimum 5000.
VITE_SPOTIFY_POLL_INTERVAL=45000
